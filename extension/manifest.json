{
  "manifest_version": 3,
  "name": "Ordi Wallet — Local Vault Preview",
  "version": "0.3.0",
  "description": "A local encrypted Bitcoin and Fractal vault with protocol routing and reviewed local PSBT tools.",
  "action": {
    "default_title": "Open Ordi Wallet",
    "default_popup": "extension.html",
    "default_icon": {
      "48": "assets/brand/ordi-wallet.png",
      "128": "assets/brand/ordi-wallet.png"
    }
  },
  "icons": {
    "48": "assets/brand/ordi-wallet.png",
    "128": "assets/brand/ordi-wallet.png"
  },
  "host_permissions": [
    "https://mempool.space/*",
    "https://mempool.fractalbitcoin.io/*",
    "https://fractal-ordinal-live.servostar23.workers.dev/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ordi-wallet-preview@demro-labs.github.io",
      "strict_min_version": "128.0"
    }
  }
}
